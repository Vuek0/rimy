BOT_TOKEN=father_bot_token
# Admins: /admin report, daily DB backup. Comma-separated Telegram ids.
ADMIN_IDS=your_telegram_id
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Telegram Mini App: the public HTTPS address where the API serves the app (empty = no app button)
WEBAPP_URL=https://app.example.com

# Free plan limits per day and the Premium price in Telegram Stars
FREE_WORDS_PER_DAY=20
FREE_VOICE_PER_DAY=20
FREE_CHAT_PER_DAY=20
FREE_CHECKS_PER_DAY=50
PREMIUM_PRICE_STARS=123
